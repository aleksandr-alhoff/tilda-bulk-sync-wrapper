msgid "Tilda Bulk Sync Wrapper requires PHP %s or newer."
msgstr "Tilda Bulk Sync Wrapper requiere PHP %s o superior."

msgid "Tilda Bulk Sync Wrapper requires WordPress %s or newer."
msgstr "Tilda Bulk Sync Wrapper requiere WordPress %s o superior."

msgid "Official plugin Tilda Publishing is not active."
msgstr "El plugin oficial Tilda Publishing no está activo."

msgid "Missing class %s in official plugin."
msgstr "Falta la clase %s en el plugin oficial."

msgid "Missing method %1$s in class %2$s of official plugin."
msgstr "Falta el método %1$s en la clase %2$s del plugin oficial."

msgid "Project %1$s: getPagesList failed: %2$s"
msgstr "Proyecto %1$s: getPagesList ha fallado: %2$s"

msgid "excluded in settings or preview"
msgstr "excluida en los ajustes o en la vista previa"

msgid "not published in Tilda"
msgstr "no publicada en Tilda"

msgid "Remote image not found, skipped: %s"
msgstr "Imagen remota no encontrada, omitida: %s"

msgid "Cannot save file to %s"
msgstr "No se puede guardar el archivo en %s"

msgid "empty response"
msgstr "respuesta vacía"

msgid "Download failed after retries: %1$s (%2$s)"
msgstr "La descarga ha fallado tras varios intentos: %1$s (%2$s)"

msgid "Task"
msgstr "Tarea"

msgid "Previous run lost its heartbeat; lock released as stale."
msgstr "La ejecución anterior dejó de responder; el bloqueo se ha liberado por obsoleto."

msgid "Cannot create page: %s"
msgstr "No se puede crear la página: %s"

msgid "No WordPress post bound to this Tilda page."
msgstr "Ninguna entrada de WordPress está vinculada a esta página de Tilda."

msgid "Slug collision resolved by WordPress suffix: %s"
msgstr "Conflicto de slug resuelto con un sufijo de WordPress: %s"

msgid "Tilda Bulk Sync"
msgstr "Sincronización masiva de Tilda"

msgid "Start bulk synchronization of all published Tilda landings?"
msgstr "¿Iniciar la sincronización masiva de todas las landings de Tilda publicadas?"

msgid "Start import of published Tilda pages into WordPress?"
msgstr "¿Iniciar la importación de las páginas de Tilda publicadas en WordPress?"

msgid "Task is running…"
msgstr "La tarea se está ejecutando…"

msgid "Task finished."
msgstr "Tarea finalizada."

msgid "Task cancelled."
msgstr "Tarea cancelada."

msgid "Error"
msgstr "Error"

msgid "Processed"
msgstr "Procesadas"

msgid "Success"
msgstr "Correctas"

msgid "Skipped"
msgstr "Omitidas"

msgid "Errors"
msgstr "Errores"

msgid "create"
msgstr "crear"

msgid "update"
msgstr "actualizar"

msgid "skip"
msgstr "omitir"

msgid "yes"
msgstr "sí"

msgid "no"
msgstr "no"

msgid "You are not allowed to access this page."
msgstr "No tienes permiso para acceder a esta página."

msgid "Tilda Bulk Sync Wrapper"
msgstr "Sincronización masiva de Tilda"

msgid "Official plugin status"
msgstr "Estado del plugin oficial"

msgid "Official Tilda Publishing plugin is active and compatible."
msgstr "El plugin oficial Tilda Publishing está activo y es compatible."

msgid "A task is currently running (lock held): %s. Wait for it to finish or cancel it below."
msgstr "Hay una tarea en ejecución (bloqueo activo): %s. Espera a que termine o cancélala abajo."

msgid "Task 1. Bulk synchronization"
msgstr "Tarea 1. Sincronización masiva"

msgid "Published landings bound to Tilda: %d"
msgstr "Landings publicadas vinculadas a Tilda: %d"

msgid "Synchronize all published Tilda landings"
msgstr "Sincronizar todas las landings de Tilda publicadas"

msgid "Task 2. Import all published pages of the Tilda project"
msgstr "Tarea 2. Importar todas las páginas publicadas del proyecto de Tilda"

msgid "Build preview of pages to import"
msgstr "Crear la vista previa de las páginas a importar"

msgid "Include"
msgstr "Incluir"

msgid "Title"
msgstr "Título"

msgid "Tilda ID"
msgstr "ID de Tilda"

msgid "Address"
msgstr "Dirección"

msgid "Action"
msgstr "Acción"

msgid "Future slug"
msgstr "Slug futuro"

msgid "Make the Tilda index page the site front page (Settings → Reading)"
msgstr "Convertir la página de índice de Tilda en la portada del sitio (Ajustes → Lectura)"

msgid "Import all published pages from Tilda"
msgstr "Importar todas las páginas publicadas desde Tilda"

msgid "Progress"
msgstr "Progreso"

msgid "No running task."
msgstr "No hay ninguna tarea en ejecución."

msgid "Cancel task"
msgstr "Cancelar tarea"

msgid "Last task report"
msgstr "Informe de la última tarea"

msgid "Type: %1$s. Status: %2$s. Started: %3$s."
msgstr "Tipo: %1$s. Estado: %2$s. Inicio: %3$s."

msgid "Total: %d"
msgstr "Total: %d"

msgid "Processed: %d"
msgstr "Procesadas: %d"

msgid "Success: %d"
msgstr "Correctas: %d"

msgid "Skipped: %d"
msgstr "Omitidas: %d"

msgid "Errors: %d"
msgstr "Errores: %d"

msgid "Page"
msgstr "Página"

msgid "No tasks have been run yet."
msgstr "Aún no se ha ejecutado ninguna tarea."

msgid "Journal (last 50 lines)"
msgstr "Registro (últimas 50 líneas)"

msgid "Journal is empty."
msgstr "El registro está vacío."

msgid "Settings"
msgstr "Ajustes"

msgid "Never import these Tilda page IDs (comma separated)"
msgstr "No importar nunca estos ID de páginas de Tilda (separados por comas)"

msgid "Batch size (pages per request, 1–10)"
msgstr "Tamaño del lote (páginas por solicitud, 1–10)"

msgid "Save settings"
msgstr "Guardar ajustes"

msgid "Required plugin \"Fullwidth Templates for Any Theme & Page Builder\" is not active. Install and activate it first: https://ru.wordpress.org/plugins/fullwidth-templates/"
msgstr "El plugin obligatorio «Fullwidth Templates for Any Theme & Page Builder» no está activo. Instálalo y actívalo primero: %s"

msgid "Tilda Bulk Sync Wrapper requires the plugin \"Fullwidth Templates for Any Theme & Page Builder\" (https://ru.wordpress.org/plugins/fullwidth-templates/). Install and activate it, then activate this plugin again."
msgstr "Tilda Bulk Sync Wrapper requiere el plugin «Fullwidth Templates for Any Theme & Page Builder» (%s). Instálalo y actívalo, y después vuelve a activar este plugin."

msgid "Tilda projects"
msgstr "Proyectos de Tilda"

msgid "No projects found. Add an API key and sync projects in the official Tilda Publishing plugin settings first."
msgstr "No se han encontrado proyectos. Añade primero una clave de API y sincroniza los proyectos en los ajustes del plugin oficial Tilda Publishing."

msgid "Select which Tilda project(s) this site should work with. Both tasks below use only the selected projects. If nothing is selected, all enabled projects are used."
msgstr "Selecciona con qué proyecto(s) de Tilda debe trabajar este sitio. Ambas tareas siguientes usan solo los proyectos seleccionados. Si no se selecciona nada, se usan todos los proyectos activados."

msgid "Projects"
msgstr "Proyectos"

msgid "(untitled)"
msgstr "(sin título)"

msgid "disabled in official plugin"
msgstr "desactivado en el plugin oficial"

msgid "Save selected projects"
msgstr "Guardar los proyectos seleccionados"

msgid "Forbidden."
msgstr "Acceso denegado."

msgid "Unknown task type."
msgstr "Tipo de tarea desconocido."

msgid "Another task is already running. Wait for it to finish or cancel it."
msgstr "Ya se está ejecutando otra tarea. Espera a que termine o cancélala."

msgid "Nothing to process: no published Tilda-bound landings or published Tilda pages found."
msgstr "Nada que procesar: no se han encontrado landings publicadas vinculadas a Tilda ni páginas de Tilda publicadas."

msgid "Lock lost or belongs to another task."
msgstr "Bloqueo perdido o pertenece a otra tarea."

msgid "Tilda Bulk Sync Wrapper requires the official \"Tilda Publishing\" plugin (https://wordpress.org/plugins/tilda-publishing/). Install and activate it, then activate this plugin again."
msgstr "Tilda Bulk Sync Wrapper requiere el plugin oficial «Tilda Publishing» (https://wordpress.org/plugins/tilda-publishing/). Instálalo y actívalo, y después vuelve a activar este plugin."
