msgid "Tilda Bulk Sync Wrapper requires PHP %s or newer."
msgstr "O Tilda Bulk Sync Wrapper requer PHP %s ou posterior."

msgid "Tilda Bulk Sync Wrapper requires WordPress %s or newer."
msgstr "O Tilda Bulk Sync Wrapper requer WordPress %s ou posterior."

msgid "Official plugin Tilda Publishing is not active."
msgstr "O plugin oficial Tilda Publishing não está ativo."

msgid "Missing class %s in official plugin."
msgstr "Classe %s ausente no plugin oficial."

msgid "Missing method %1$s in class %2$s of official plugin."
msgstr "Método %1$s ausente na classe %2$s do plugin oficial."

msgid "Project %1$s: getPagesList failed: %2$s"
msgstr "Projeto %1$s: getPagesList falhou: %2$s"

