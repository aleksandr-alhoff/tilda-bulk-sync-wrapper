msgstr "O download falhou após várias tentativas: %1$s (%2$s)"

msgid "Task"
msgstr "Tarefa"

msgid "Previous run lost its heartbeat; lock released as stale."
msgstr "A execução anterior parou de responder; o bloqueio foi liberado como obsoleto."

msgid "Cannot create page: %s"
msgstr "Não foi possível criar a página: %s"

msgid "No WordPress post bound to this Tilda page."
msgstr "Nenhum conteúdo do WordPress está vinculado a esta página do Tilda."

msgid "Slug collision resolved by WordPress suffix: %s"
msgstr "Conflito de slug resolvido com sufixo do WordPress: %s"

msgid "Tilda Bulk Sync"
msgstr "Sincronização em massa do Tilda"

msgid "Start bulk synchronization of all published Tilda landings?"
msgstr "Iniciar a sincronização em massa de todas as landings publicadas do Tilda?"

msgid "Start import of published Tilda pages into WordPress?"
msgstr "Iniciar a importação das páginas publicadas do Tilda para o WordPress?"

msgid "Task is running…"
msgstr "Tarefa em execução…"

msgid "Task finished."
msgstr "Tarefa concluída."

msgid "Task cancelled."
msgstr "Tarefa cancelada."

msgid "Error"
msgstr "Erro"

msgid "Processed"
msgstr "Processadas"

msgid "Success"
msgstr "Sucesso"

msgid "Skipped"
msgstr "Ignoradas"

