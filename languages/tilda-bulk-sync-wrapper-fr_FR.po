msgstr "Faire de la page d’index Tilda la page d’accueil du site (Réglages → Lecture)"

msgid "Import all published pages from Tilda"
msgstr "Importer toutes les pages publiées depuis Tilda"

msgid "Progress"
msgstr "Progression"

msgid "No running task."
msgstr "Aucune tâche en cours."

msgid "Cancel task"
msgstr "Annuler la tâche"

