msgstr "Conflit de slug résolu par un suffixe WordPress : %s"

msgid "Tilda Bulk Sync"
msgstr "Synchronisation en masse Tilda"

msgid "Start bulk synchronization of all published Tilda landings?"
msgstr "Lancer la synchronisation en masse de toutes les pages de destination Tilda publiées ?"

msgid "Start import of published Tilda pages into WordPress?"
msgstr "Lancer l’importation des pages Tilda publiées dans WordPress ?"

