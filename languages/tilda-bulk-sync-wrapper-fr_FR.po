msgstr "Total : %d"

msgid "Processed: %d"
msgstr "Traitées : %d"

msgid "Success: %d"
msgstr "Succès : %d"

msgid "Skipped: %d"
msgstr "Ignorées : %d"

msgid "Errors: %d"
msgstr "Erreurs : %d"

msgid "Page"
msgstr "Page"

msgid "No tasks have been run yet."
msgstr "Aucune tâche n’a encore été exécutée."

msgid "Journal (last 50 lines)"
msgstr "Journal (50 dernières lignes)"

msgid "Journal is empty."
msgstr "Le journal est vide."

msgid "Settings"
msgstr "Réglages"

msgid "Never import these Tilda page IDs (comma separated)"
msgstr "Ne jamais importer ces ID de pages Tilda (séparés par des virgules)"

msgid "Batch size (pages per request, 1–10)"
msgstr "Taille du lot (pages par requête, 1–10)"

msgid "Save settings"
msgstr "Enregistrer les réglages"

msgid "Required plugin \"Fullwidth Templates for Any Theme & Page Builder\" is not active. Install and activate it first: https://ru.wordpress.org/plugins/fullwidth-templates/"
msgstr "L’extension requise « Fullwidth Templates for Any Theme & Page Builder » n’est pas active. Installez-la et activez-la d’abord : %s"

msgid "Tilda Bulk Sync Wrapper requires the plugin \"Fullwidth Templates for Any Theme & Page Builder\" (https://ru.wordpress.org/plugins/fullwidth-templates/). Install and activate it, then activate this plugin again."
msgstr "Tilda Bulk Sync Wrapper nécessite l’extension « Fullwidth Templates for Any Theme & Page Builder » (https://ru.wordpress.org/plugins/fullwidth-templates/). Installez-la et activez-la, puis réactivez cette extension."

msgid "Tilda projects"
msgstr "Projets Tilda"

msgid "No projects found. Add an API key and sync projects in the official Tilda Publishing plugin settings first."
msgstr "Aucun projet trouvé. Ajoutez d’abord une clé API et synchronisez les projets dans les réglages de l’extension officielle Tilda Publishing."

msgid "Select which Tilda project(s) this site should work with. Both tasks below use only the selected projects. If nothing is selected, all enabled projects are used."
msgstr "Sélectionnez le ou les projets Tilda avec lesquels ce site doit travailler. Les deux tâches ci-dessous n’utilisent que les projets sélectionnés. Si rien n’est sélectionné, tous les projets activés sont utilisés."

msgid "Projects"
msgstr "Projets"

msgid "(untitled)"
msgstr "(sans titre)"

msgid "disabled in official plugin"
msgstr "désactivé dans l’extension officielle"

msgid "Save selected projects"
msgstr "Enregistrer les projets sélectionnés"

msgid "Forbidden."
msgstr "Accès interdit."

msgid "Unknown task type."
msgstr "Type de tâche inconnu."

msgid "Another task is already running. Wait for it to finish or cancel it."
msgstr "Une autre tâche est déjà en cours. Attendez qu’elle se termine ou annulez-la."

msgid "Nothing to process: no published Tilda-bound landings or published Tilda pages found."
msgstr "Rien à traiter : aucune page de destination publiée liée à Tilda ni page Tilda publiée trouvée."

msgid "Lock lost or belongs to another task."
msgstr "Verrou perdu ou appartenant à une autre tâche."

msgid "Tilda Bulk Sync Wrapper requires the official \"Tilda Publishing\" plugin (https://wordpress.org/plugins/tilda-publishing/). Install and activate it, then activate this plugin again."
msgstr "Tilda Bulk Sync Wrapper nécessite l’extension officielle « Tilda Publishing » (https://wordpress.org/plugins/tilda-publishing/). Installez-la et activez-la, puis réactivez cette extension."
