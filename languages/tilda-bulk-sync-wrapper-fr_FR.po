msgstr "Synchronisation en masse Tilda"

msgid "Official plugin status"
msgstr "État de l’extension officielle"

msgid "Official Tilda Publishing plugin is active and compatible."
msgstr "L’extension officielle Tilda Publishing est active et compatible."

msgid "A task is currently running (lock held): %s. Wait for it to finish or cancel it below."
msgstr "Une tâche est en cours (verrou actif) : %s. Attendez qu’elle se termine ou annulez-la ci-dessous."

msgid "Task 1. Bulk synchronization"
msgstr "Tâche 1. Synchronisation en masse"

msgid "Published landings bound to Tilda: %d"
msgstr "Pages de destination publiées liées à Tilda : %d"

msgid "Synchronize all published Tilda landings"
msgstr "Synchroniser toutes les pages de destination Tilda publiées"

msgid "Task 2. Import all published pages of the Tilda project"
msgstr "Tâche 2. Importer toutes les pages publiées du projet Tilda"

msgid "Build preview of pages to import"
msgstr "Générer l’aperçu des pages à importer"

