msgid "Tilda Bulk Sync Wrapper requires PHP %s or newer."
msgstr "Tilda Bulk Sync Wrapper nécessite PHP %s ou une version ultérieure."

msgid "Tilda Bulk Sync Wrapper requires WordPress %s or newer."
msgstr "Tilda Bulk Sync Wrapper nécessite WordPress %s ou une version ultérieure."

msgid "Official plugin Tilda Publishing is not active."
msgstr "L’extension officielle Tilda Publishing n’est pas active."

msgid "Missing class %s in official plugin."
msgstr "Classe %s manquante dans l’extension officielle."

msgid "Missing method %1$s in class %2$s of official plugin."
msgstr "Méthode %1$s manquante dans la classe %2$s de l’extension officielle."

